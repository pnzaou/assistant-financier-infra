# Copier vers terraform.tfvars puis ajuster.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars est ignoré par git : il contient l'identifiant de ton
# abonnement Azure, qui n'a rien à faire dans un dépôt public.

# az account show --query id -o tsv
id_abonnement = "00000000-0000-0000-0000-000000000000"

groupe_ressources = "assistant-financier-rg"

# westeurope : plus de capacité Spot et moins cher que francecentral, qui est
# la région la plus proche de Dakar en latence. Arbitrage assumé : sur un
# projet d'école, la disponibilité des VM Spot compte plus que 20 ms de RTT.
region = "westeurope"

nom_cluster = "assistant-financier"

# Laisser null pour prendre la version stable par défaut de la région.
version_kubernetes = null

# ─── Pool système (Regular obligatoire — Azure refuse un pool système Spot)
taille_noeud_systeme = "Standard_B2s"
nb_noeuds_systeme    = 1

# ─── Pool applicatif
taille_noeud_app  = "Standard_B2s"
nb_noeuds_app_min = 1
nb_noeuds_app_max = 1

# ATTENTION — false est OBLIGATOIRE sur un abonnement d'essai gratuit.
#
# Azure ne propose pas les VM Spot aux abonnements Free Trial, Azure for
# Students ni MSDN. La création du pool échouerait avec une erreur de type
# « SkuNotAvailable » ou « OperationNotAllowed », après plusieurs minutes
# d'attente. Repasser à true seulement après conversion en paiement à l'usage.
noeuds_spot = false

# ─── Quota
# Un abonnement d'essai est plafonné à 4 vCPU par région. Deux Standard_B2s
# (2 vCPU chacune) consomment donc EXACTEMENT le quota : d'où
# nb_noeuds_app_max = 1 ci-dessus. Vérifier avant l'apply :
#   az vm list-usage --location westeurope -o table | grep -i "Total Regional vCPUs"

activer_observabilite = true

# NE PAS mettre le mot de passe Grafana ici. Passer par l'environnement :
#   export TF_VAR_mot_de_passe_grafana='...'      (bash)
#   $env:TF_VAR_mot_de_passe_grafana = '...'      (PowerShell)

# Liste vide = API Kubernetes ouverte à tous. À restreindre dès que possible :
#   plages_autorisees_api = ["41.82.x.x/32"]
plages_autorisees_api = []

etiquettes = {
  projet      = "assistant-financier"
  gere_par    = "terraform"
  environment = "staging"
}
